# Copy to .env.local and fill in. Never commit real values.

# Public site URL used in metadata, canonical URLs, sitemap and email links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database file for the built-in SQLite driver (defaults to data/bayan.db)
DATABASE_PATH=./data/bayan.db

# Email delivery. When RESEND_API_KEY is unset, messages are written to data/outbox/*.eml
RESEND_API_KEY=
EMAIL_FROM="BAYAN GROUP <no-reply@example.com>"

# Bootstrap admin created by `npm run db:reset` / `npm run db:seed`
ADMIN_EMAIL=admin@bayan-group.qa
ADMIN_PASSWORD=ChangeMe123!
